# Eggley Company — configuration Apache
# Prérequis : modules rewrite, headers, expires, deflate et « AllowOverride All » sur le dossier du site.

Options -Indexes -MultiViews
DirectoryIndex index.html
ErrorDocument 404 /404.html

AddType font/woff2 .woff2
AddType image/webp .webp
AddDefaultCharset UTF-8

<IfModule mod_rewrite.c>
  RewriteEngine On

  # 0. Protocole courant (https derrière un proxy aussi) -> variable PROTO
  RewriteRule ^ - [E=PROTO:http]
  RewriteCond %{HTTPS} =on [OR]
  RewriteCond %{HTTP:X-Forwarded-Proto} =https
  RewriteRule ^ - [E=PROTO:https]

  # 1. Forcer HTTPS — uniquement sur le vrai domaine (un test par IP reste en http)
  RewriteCond %{HTTP_HOST} ^(www\.)?eggleycompany\.net$ [NC]
  RewriteCond %{ENV:PROTO} =http
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # 2. Domaine unique : www.eggleycompany.net -> eggleycompany.net
  RewriteCond %{HTTP_HOST} ^www\.(eggleycompany\.net)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [L,R=301]

  # 3. Anciennes adresses de l'ancien site
  RewriteRule ^contact\.php$ %{ENV:PROTO}://%{HTTP_HOST}/contact [L,R=301]
  RewriteRule ^contacts(\.html)?$ %{ENV:PROTO}://%{HTTP_HOST}/contact [L,R=301]
  RewriteRule ^service-details(\.html)?$ %{ENV:PROTO}://%{HTTP_HOST}/services [L,R=301]

  # 4. /index ou /index.html -> /   (idem pour /v1/index et /v2/index)
  RewriteCond %{THE_REQUEST} \s/+(v[12]/)?index(\.html)?[\s?] [NC]
  RewriteRule ^ %{ENV:PROTO}://%{HTTP_HOST}/%1 [L,R=301]

  # 5. /page.html -> /page (seulement pour les requêtes du navigateur)
  RewriteCond %{THE_REQUEST} \s/+([^\s?]+?)\.html[\s?] [NC]
  RewriteRule ^ %{ENV:PROTO}://%{HTTP_HOST}/%1 [L,R=301,NE]

  # 6. Supprimer la barre oblique finale (/page/ -> /page)
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^(.+)/$ %{ENV:PROTO}://%{HTTP_HOST}/$1 [L,R=301]

  # 7. /page -> sert page.html sans changer l'adresse (version actuelle à la racine, archives sous /v1/ et /v2/)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{DOCUMENT_ROOT}/$1.html -f
  RewriteRule ^((?:v1/|v2/)?[a-z0-9-]+)$ $1.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  <FilesMatch "\.(css|js|woff2|webp|jpe?g|png|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript image/svg+xml application/xml text/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/x-icon "access plus 6 months"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/pdf "access plus 1 month"
</IfModule>
